---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here. Try the Hoagiestack home page, the platform comparison, or the blog.">
  <section class="section--cream hero hero--interior" aria-labelledby="page-title">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 id="page-title">That page isn't on the menu.</h1>
      <p class="lede">It may have moved. These are the places most people are looking for:</p>
      <div class="btn-row">
        <a class="btn btn--ink" href="/">Home</a>
        <a class="btn btn--ink" href="/alternatives">Compare the alternatives</a>
        <a class="btn btn--ink" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
