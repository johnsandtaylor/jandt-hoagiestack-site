---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { bookingUrl } from '../site';

const plans = [
  {
    name: 'Kit',
    price: '$89',
    tag: 'Managed',
    pro: 'Creator Network recommends your newsletter to readers of other lists.',
    con: 'No self-hosted option, but reliability is strong.',
    href: 'https://partners.kit.com/mo5dw8gkbfsr-uw04r',
    linkLabel: 'Visit Kit',
    linkNote: '(affiliate link)',
  },
  {
    name: 'WordPress',
    featured: true,
    price: '$149',
    priceNote: '†',
    tag: 'Custom · built on our Hoagiestack theme',
    pro: 'Hoagiestack, the custom WordPress theme we build for our clients, gives you Substack-style publishing on a site you own and can move between hosts.',
    con: 'No built-in recommendation network. It needs ongoing maintenance to stay secure, and our plan covers that.',
    href: bookingUrl('alternatives-wordpress'),
    linkLabel: 'Book a call about Hoagiestack',
  },
  {
    name: 'Ghost',
    price: '$239',
    tag: 'Managed',
    pro: 'The most Substack-like publishing and reader experience of the three, and the fastest to get running.',
    con: "Self-hosting is possible but complex; you're on your own for growth.",
    href: 'https://ghost.org/',
    linkLabel: 'Visit Ghost',
  },
];
---
<Base
  title="Three Substack alternatives we've used with clients"
  description="Kit, Ghost and WordPress compared for a newsletter with about 5,000 subscribers: monthly price, what each does well, and what you give up."
>
  <section class="section--cream hero hero--interior" aria-labelledby="page-title">
    <div class="container">
      <p class="eyebrow">Compare</p>
      <h1 id="page-title">Three Substack alternatives we've used with clients</h1>
      <p class="lede">Each one trades a different amount of work for a different amount of control. Here's how they compare for a newsletter with about 5,000 subscribers.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <h2 id="compare-title" class="sr-only">Newsletter platform alternatives comparison</h2>
      <div class="compare-cards">
        {plans.map((p) => (
          <article class:list={['card', 'plan', { 'plan--featured': p.featured }]} aria-labelledby={`plan-${p.name}`}>
            <h3 id={`plan-${p.name}`}>{p.name}{p.featured && <> <span class="plan__flag">Our pick</span></>}</h3>
            <p class="plan__tag">{p.tag}</p>
            <p class="plan__price">{p.price}<small>/mo*{p.priceNote}</small></p>
            <dl>
              <div><dt>Pros</dt><dd>{p.pro}</dd></div>
              <div><dt>Cons</dt><dd>{p.con}</dd></div>
            </dl>
            <p><a class="card__link" href={p.href}>{p.linkLabel}</a>{p.linkNote && <span> {p.linkNote}</span>}</p>
          </article>
        ))}
      </div>

      <div class="footnotes">
        <p>* Assumes 5,000 subscribers across free and paid tiers and up to 50,000 emails a month. Prices checked September 2026.</p>
        <p>† Includes monthly hosting, outbound email delivered through SendGrid (we manage it for you), and setup and annual maintenance of your Hoagiestack site spread across the year. Stripe's subscription processing fees are separate and paid by you. They typically run 3–7% of each payment, depending on where you're based and which tier of service you're on.</p>
        <p>Ghost's Business plan is billed monthly without the annual discount and includes priority support; billed annually, the same plan is $199/mo. Ghost prices by member count, so a 5,000-member list lands on its Business plan rather than its Publisher plan.</p>
      </div>
    </div>
  </section>

  <section class="section section--gray" aria-labelledby="managed">
    <div class="container narrow prose">
      <h2 id="managed">Managed or assembled?</h2>
      <p>Kit and Ghost's hosted plans are managed. You pay for convenience and support, and someone else keeps the lights on. WordPress is assembled. You pick the parts and keep more portability, and someone — you, or a consultant you trust — has to maintain it. For our clients, that's us: we build on Hoagiestack, our own custom WordPress theme, and look after the hosting, SendGrid email delivery, and upkeep.</p>
      <p>There are plenty of other Substack alternatives worth a look, but these are the three our team has had good experiences with. Beehiiv is a strong alternative, and it's missing from this list for one reason: it has the same portability problem. A principle we work by at Johns &amp; Taylor is that you shouldn't be stuck on a platform if it changes its terms and conditions, or if one of its founders does something that goes against your values or your audience's.</p>
      <p>Whatever you choose, budget for Stripe's payment processing fees — 2.9% plus 30 cents on each successful charge for standard US cards, as of September 2026 — and $10–20 a year for your own domain.</p>
    </div>
  </section>

  <CtaBand placement="alternatives" heading="Want a second set of eyes before you pick?">
    <p>Bring your list size, your paid tiers, and how much upkeep you want to own. We'll help you weigh the options in half an hour.</p>
  </CtaBand>
</Base>
