---
import '../styles/global.css';
import { NAV, CTA_LABEL, CTA_SHORT, EMAIL, bookingUrl } from '../site';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  seoTitle?: string;
}

const { title, description, type = 'website', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const { seoTitle } = Astro.props;
const baseTitle = seoTitle ?? title;
const fullTitle = title === 'Hoagiestack'
  ? 'Hoagiestack: Substack alternatives for independent writers'
  : (baseTitle.length + 14 <= 65 ? `${baseTitle} | Hoagiestack` : baseTitle);
const ogImage = new URL('/og.png', Astro.site).href;
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');

const org = {
  '@type': 'Organization',
  '@id': 'https://johnsandtaylor.com/#org',
  name: 'Johns & Taylor',
  url: 'https://johnsandtaylor.com',
  email: EMAIL,
  address: { '@type': 'PostalAddress', addressLocality: 'Collingswood', addressRegion: 'NJ', addressCountry: 'US' },
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    { '@type': 'WebSite', '@id': 'https://hoagiestack.com/#site', name: 'Hoagiestack', url: 'https://hoagiestack.com', publisher: { '@id': org['@id'] } },
    ...(jsonLd ? [jsonLd] : []),
  ],
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fef6ea" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Hoagiestack" />
    <meta property="og:title" content={title === 'Hoagiestack' ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hoagiestack, a primer on newsletter hosting by Joe Taylor Jr." />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- J&T's Adobe Fonts kit (P22 Mackinac Pro), loaded without blocking first paint; Georgia stands in until it arrives. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="preload" href="https://use.typekit.net/gxu3pkm.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/gxu3pkm.css" /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="Hoagiestack home">
          <span class="brand__name">Hoagiestack</span>
          <span class="brand__by">by Johns &amp; Taylor</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
            <li class="nav-cta"><a class="btn btn--primary" href={bookingUrl('header')}>{CTA_SHORT}</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer on-dark">
      <div class="container">
        <div class="grid">
          <div>
            <h2>About Hoagiestack</h2>
            <p>Hoagiestack is a project of <a href="https://johnsandtaylor.com"><u>Johns &amp; Taylor</u></a>, a user experience and web development agency in Collingswood, New Jersey. We've been building publishing tools for newsrooms and media businesses since 1998.</p>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Home</a></li>
              {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Get in touch</h2>
            <ul>
              <li><a href={bookingUrl('footer')}>{CTA_LABEL}</a></li>
              <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p>© {year} Johns &amp; Taylor. Some links on this site are affiliate links; we say so where they appear.</p>
          <nav aria-label="Legal">
            <ul>
              <li><a href="https://johnsandtaylor.com/privacy/">Privacy</a></li>
              <li><a href="https://johnsandtaylor.com/terms/">Terms of Service</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
